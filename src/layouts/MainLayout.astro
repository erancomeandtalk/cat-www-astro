---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { isRTL, type Lang, type PageKey } from "../i18n";
import "../styles/global.css";

interface Props {
	lang: Lang;
	page?: PageKey;
	title: string;
	description: string;
	noindex?: boolean;
}

const { lang, page, title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={isRTL(lang) ? "rtl" : "ltr"}>
	<head>
		<SEO lang={lang} page={page} title={title} description={description} noindex={noindex} />
		<slot name="head" />
	</head>
	<body>
		<Header lang={lang} page={page} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
