---
import { Image } from "astro:assets";
import icon from "../assets/cat-icon.png";
import StoreBadges from "./StoreBadges.astro";
import { COMPANY_NAME, SUPPORT_EMAIL } from "../config";
import { pathFor, useTranslations, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div class="site-footer__brand">
			<a class="brand" href={pathFor("home", lang)} aria-label={t.a11y.homeLink}>
				<Image src={icon} alt="" width={40} height={40} densities={[1, 2]} class="brand__icon" />
				<span class="brand__text" aria-hidden="true">
					<span class="brand__name">CAT</span>
					<span class="brand__tag">Come And Talk</span>
				</span>
			</a>
			<p class="site-footer__tagline">{t.footer.tagline}</p>
		</div>

		<nav class="site-footer__nav" aria-label={t.a11y.footerNav}>
			<div>
				<h2 class="site-footer__heading">{t.footer.explore}</h2>
				<ul>
					<li><a href={pathFor("home", lang)}>{t.nav.home}</a></li>
					<li><a href={pathFor("founders", lang)}>{t.nav.founders}</a></li>
					<li><a href={pathFor("contact", lang)}>{t.nav.contact}</a></li>
					<li><a class="ltr-text" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
				</ul>
			</div>
			<div>
				<h2 class="site-footer__heading">{t.footer.legal}</h2>
				<ul>
					<li><a href={pathFor("privacy", lang)}>{t.nav.privacy}</a></li>
					<li><a href={pathFor("childSafety", lang)}>{t.nav.childSafety}</a></li>
					<li><a href={pathFor("deleteAccount", lang)}>{t.nav.deleteAccount}</a></li>
				</ul>
			</div>
		</nav>

		<div class="site-footer__app">
			<h2 class="site-footer__heading">{t.footer.getApp}</h2>
			<StoreBadges lang={lang} size="md" />
		</div>
	</div>

	<div class="container site-footer__bottom">
		<p>© {year} <span class="ltr-text">{COMPANY_NAME}</span>. {t.footer.rights}</p>
	</div>
</footer>
