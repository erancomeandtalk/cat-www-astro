---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import StoreBadges from "../components/StoreBadges.astro";
import Icon from "../components/Icon.astro";
import mascot from "../assets/mascot.png";
import { pathFor, useTranslations } from "../i18n";

// One 404 page for both languages: English first, with a Hebrew block.
const en = useTranslations("en");
const he = useTranslations("he");
---

<MainLayout lang="en" title={en.meta.notFound.title} description={en.meta.notFound.description} noindex>
	<section class="section not-found">
		<div class="container container--narrow not-found__inner">
			<Image src={mascot} alt="" width={130} densities={[1, 1.5]} class="not-found__mascot" />
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1 class="page-title">{en.notFound.title}</h1>
			<p class="lead">{en.notFound.text}</p>
			<div class="button-row">
				<a class="btn btn--primary" href={pathFor("home", "en")}>{en.notFound.home}</a>
				<a class="btn btn--secondary" href={pathFor("contact", "en")}>{en.notFound.contact}</a>
			</div>

			<div class="not-found__alt" lang="he" dir="rtl">
				<h2 class="not-found__alt-title">{he.notFound.title}</h2>
				<p>{he.notFound.text}</p>
				<a class="text-link" href={pathFor("home", "he")}>
					{he.notFound.home}
					<Icon name="arrow" size={16} />
				</a>
			</div>

			<StoreBadges lang="en" size="md" center />
		</div>
	</section>
</MainLayout>
