---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import StoreBadges from "../components/StoreBadges.astro";
import Icon from "../components/Icon.astro";
import mascot from "../assets/mascot.png";
import { defaultLang, isRTL, languages, pathFor, useTranslations, type Lang } from "../i18n";

// One 404 page: English first, followed by every other supported language.
const en = useTranslations(defaultLang);
const alternateLanguages = (Object.keys(languages) as Lang[])
	.filter((lang) => lang !== defaultLang)
	.map((lang) => ({ lang, t: useTranslations(lang) }));
---

<MainLayout lang="en" title={en.meta.notFound.title} description={en.meta.notFound.description} noindex>
	<section class="section not-found">
		<div class="container container--narrow not-found__inner">
			<Image src={mascot} alt="" width={130} densities={[1, 1.5]} class="not-found__mascot" />
			<p class="not-found__code" aria-hidden="true">404</p>
			<h1 class="page-title">{en.notFound.title}</h1>
			<p class="lead">{en.notFound.text}</p>
			<div class="button-row">
				<a class="btn btn--primary" href={pathFor("home", "en")}>{en.notFound.home}</a>
				<a class="btn btn--secondary" href={pathFor("contact", "en")}>{en.notFound.contact}</a>
			</div>

			{
				alternateLanguages.map(({ lang, t }) => (
					<div class="not-found__alt" lang={lang} dir={isRTL(lang) ? "rtl" : "ltr"}>
						<h2 class="not-found__alt-title">{t.notFound.title}</h2>
						<p>{t.notFound.text}</p>
						<a class="text-link" href={pathFor("home", lang)}>
							{t.notFound.home}
							<Icon name="arrow" size={16} />
						</a>
					</div>
				))
			}

			<StoreBadges lang="en" size="md" center />
		</div>
	</section>
</MainLayout>
